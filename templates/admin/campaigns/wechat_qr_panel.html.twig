{% trans_default_domain 'smsh_ticketing_bridge' %}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header d-block">
        <h3 class="card-title mb-0">{{ 'wechat_campaign_qr.card_title'|trans }}</h3>
    </div>
    <div class="card-body">
        <p class="text-body-secondary small mb-3">
            {{ 'wechat_campaign_qr.card_intro'|trans }}
        </p>

        {% if wechat_campaign_qr.status == 'ready' %}
            {% for item in wechat_campaign_qr.items %}
                <div class="d-flex flex-wrap align-items-start gap-3{% if not loop.last %} mb-4{% endif %}">
                    <a href="{{ item.imageUrl }}" target="_blank" rel="noopener noreferrer">
                        <img
                            src="{{ item.imageUrl }}"
                            alt="{{ 'wechat_campaign_qr.img_alt'|trans }}"
                            class="rounded border bg-white"
                            width="220"
                            height="220"
                            loading="lazy"
                        >
                    </a>
                    <div class="small">
                        {% if wechat_campaign_qr.items|length > 1 %}
                            <div class="fw-semibold mb-1">{{ 'wechat_campaign_qr.event_heading'|trans }}</div>
                            <div class="mb-3">{{ item.eventLabel|default('#' ~ item.eventId) }}</div>
                        {% endif %}
                        <div class="fw-semibold mb-1">{{ 'wechat_campaign_qr.scene_heading'|trans }}</div>
                        <code class="text-break">{{ item.scene }}</code>
                        <div class="fw-semibold mt-3 mb-1">{{ 'wechat_campaign_qr.page_heading'|trans }}</div>
                        <code class="text-break">{{ item.page }}</code>
                        <div class="mt-3">
                            <a href="{{ item.imageUrl }}" target="_blank" rel="noopener noreferrer">
                                {{ 'wechat_campaign_qr.open_image'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% elseif wechat_campaign_qr.status == 'no_code' %}
            <p class="text-body-secondary mb-0">{{ 'wechat_campaign_qr.no_code'|trans }}</p>
        {% elseif wechat_campaign_qr.status == 'not_configured' %}
            <p class="text-body-secondary mb-0">
                {% if wechat_campaign_qr.reason == 'event' %}
                    {{ 'wechat_campaign_qr.not_configured_event'|trans }}
                {% elseif wechat_campaign_qr.reason == 'page' %}
                    {{ 'wechat_campaign_qr.not_configured_page'|trans }}
                {% elseif wechat_campaign_qr.reason == 'credentials' %}
                    {{ 'wechat_campaign_qr.not_configured_credentials'|trans }}
                {% else %}
                    {{ 'wechat_campaign_qr.not_configured'|trans }}
                {% endif %}
            </p>
        {% else %}
            <p class="text-danger mb-0">
                {{ 'wechat_campaign_qr.failed'|trans({'%message%': wechat_campaign_qr.errorMessage|default('')}) }}
            </p>
        {% endif %}
    </div>
</div>
